
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= bike.name %> - Rathika</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <h1><%= bike.name %></h1>

    <% if (bike.image) { %>

        <img
            src="<%= bike.image %>"
            alt="<%= bike.name %>"
            style="
                width: 450px;
                max-width: 100%;
                height: 300px;
                object-fit: cover;
                border-radius: 8px;
            "
        >

    <% } else { %>

        <p>No image available for this bike.</p>

    <% } %>

    <p>Brand: <%= bike.brand %></p>

    <p>Type: <%= bike.type %></p>

    <p>₹<%= bike.pricePerDay %> / day</p>

    <p><%= bike.description %></p>

    <h2>Specifications</h2>

    <p>Engine: <%= bike.specifications.engine || "Not specified" %></p>

    <p>Mileage: <%= bike.specifications.mileage || "Not specified" %></p>

    <p>Transmission: <%= bike.specifications.transmission || "Not specified" %></p>

    <br>

    <a href="/bookings/new/<%= bike._id %>">Book Now</a>

    <br><br>

    <a href="/bikes">← Back to Bikes</a>

</body>
</html>
