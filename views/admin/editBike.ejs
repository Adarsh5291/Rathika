
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Bike - Rathika</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <h1>Edit <%= bike.name %></h1>

    <form
        action="/admin/bikes/<%= bike._id %>/edit"
        method="POST"
        enctype="multipart/form-data"
    >

        <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
        >

        <label>Bike Name</label>
        <input
            type="text"
            name="name"
            value="<%= bike.name %>"
            maxlength="100"
            required
        >

        <label>Brand</label>
        <input
            type="text"
            name="brand"
            value="<%= bike.brand %>"
            maxlength="50"
            required
        >

        <label>Type</label>
        <select name="type" required>
            <% ["Sports", "Classic", "Cruiser", "Adventure", "Scooter", "Other"].forEach(type => { %>
                <option
                    value="<%= type %>"
                    <%= bike.type === type ? "selected" : "" %>
                >
                    <%= type %>
                </option>
            <% }) %>
        </select>

        <label>Price Per Day (₹)</label>
        <input
            type="number"
            name="pricePerDay"
            min="1"
            step="0.01"
            value="<%= bike.pricePerDay %>"
            required
        >

        <label>Description</label>
        <textarea
            name="description"
            maxlength="1000"
            required
        ><%= bike.description %></textarea>

        <label>Engine</label>
        <input
            type="text"
            name="engine"
            value="<%= bike.specifications?.engine || '' %>"
        >

        <label>Mileage</label>
        <input
            type="text"
            name="mileage"
            value="<%= bike.specifications?.mileage || '' %>"
        >

        <label>Transmission</label>
        <input
            type="text"
            name="transmission"
            value="<%= bike.specifications?.transmission || '' %>"
        >

        <label>Current Bike Image</label>

        <% if (bike.image) { %>
            <div>
                <img
                    src="<%= bike.image %>"
                    alt="<%= bike.name %>"
                    style="max-width: 300px; max-height: 200px; object-fit: contain;"
                >
            </div>
        <% } else { %>
            <p>No image uploaded yet.</p>
        <% } %>

        <label>Replace Bike Image (Optional)</label>

        <input
            type="file"
            name="image"
            accept="image/jpeg,image/png,image/webp"
        >

        <p>
            Leave this empty to keep the current image.
            Allowed formats: JPG, JPEG, PNG and WebP.
            Maximum size: 2 MB.
        </p>

        <button type="submit">Save Changes</button>

    </form>

    <a href="/admin/bikes">Back to Bikes</a>

</body>
</html>
