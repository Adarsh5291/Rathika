
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - Rathika</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <h1>Welcome, <%= user.name %>!</h1>

    <h2>Your Account</h2>

    <p>Email: <%= user.email %></p>

    <p>Role: <%= user.role %></p>

    <br>

    <a href="/bikes">Browse Bikes</a>

    <hr>

    <h2>My Bookings</h2>

    <% if (bookings.length === 0) { %>

        <p>You haven't made any bookings yet.</p>

    <% } else { %>

        <% bookings.forEach(booking => { %>

            <div>

                <% if (booking.bikeUnit && booking.bikeUnit.bike) { %>

                    <h3>
                        <%= booking.bikeUnit.bike.name %>
                    </h3>

                    <% if (booking.bikeUnit.bike.image) { %>

                        <img
                            src="<%= booking.bikeUnit.bike.image %>"
                            alt="<%= booking.bikeUnit.bike.name %>"
                            style="
                                width: 250px;
                                height: 160px;
                                object-fit: cover;
                                border-radius: 8px;
                            "
                        >

                    <% } else { %>

                        <p>No image available for this bike.</p>

                    <% } %>

                    <p>
                        Brand: <%= booking.bikeUnit.bike.brand %>
                    </p>

                <% } else { %>

                    <h3>Bike information unavailable</h3>

                <% } %>

                <p>
                    Pickup Date:
                    <%= booking.pickupDate.toDateString() %>
                </p>

                <p>
                    Return Date:
                    <%= booking.returnDate.toDateString() %>
                </p>

                <p>
                    Total Amount: ₹<%= booking.totalAmount %>
                </p>

                <p>
                    Booking Status: <%= booking.bookingStatus %>
                </p>

                <p>
                    Payment Status: <%= booking.paymentStatus %>
                </p>

                <% if (
                    booking.bikeUnit &&
                    booking.bookingStatus === "Pending" &&
                    booking.paymentStatus === "Pending" &&
                    booking.bikeUnit.status === "Available"
                ) { %>

                    <a href="/bookings/<%= booking._id %>/payment">
                        <button type="button">Complete Payment</button>
                    </a>

                <% } %>

                <% if (["Pending", "Confirmed"].includes(booking.bookingStatus)) { %>

                    <form
                        action="/bookings/<%= booking._id %>/cancel"
                        method="POST"
                    >

                        <input
                            type="hidden"
                            name="_csrf"
                            value="<%= csrfToken %>"
                        >

                        <button type="submit">Cancel Booking</button>

                    </form>

                <% } %>

            </div>

            <hr>

        <% }) %>

    <% } %>

    <br><br>

    <form action="/logout" method="POST">

        <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
        >

        <button type="submit">Logout</button>

    </form>

</body>
</html>
